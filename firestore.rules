rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email in ['niazskapp@gmail.com', 'fayselsk@gmail.com']
        )
      );
    }

    function isSuperAgent() {
      return isVerifiedUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'SUPER_AGENT';
    }

    // BD Agent: ONLY the provisioned SUPER_AGENT account with ID 111112.
    // Every other SUPER_AGENT is a regular Super Agent.
    function isBdAgent() {
      return isVerifiedUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'SUPER_AGENT' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformId == '111112';
    }

    function isAgent() {
      return isVerifiedUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'AGENT';
    }

    function isAgencyWallet(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.accountType in ['AGENT', 'SUPER_AGENT'];
    }

    function isAgentWallet(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.accountType == 'AGENT';
    }

    function isUserWallet(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.accountType == 'USER';
    }

    function isRoomHost(roomId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/liveRooms/$(roomId)) &&
        get(/databases/$(database)/documents/liveRooms/$(roomId)).data.hostUid == request.auth.uid;
    }

    function isRoomHostAfter(roomId) {
      return isVerifiedUser() &&
        existsAfter(/databases/$(database)/documents/liveRooms/$(roomId)) &&
        getAfter(/databases/$(database)/documents/liveRooms/$(roomId)).data.hostUid == request.auth.uid;
    }

    // Connection health check document
    match /test/connection {
      allow get: if true;
    }

    // Admin registry (managed via Console / Admin SDK)
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
    }

    // Validation Blueprints
    function isValidUserPublic(data, uid) {
      return data.keys().hasAll([
          'uid', 'platformId', 'username', 'displayName', 'accountType',
          'followersCount', 'followingCount', 'isOnline', 'showPresence',
          'isSuspended', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'platformId', 'username', 'displayName', 'bio', 'country',
          'gender', 'accountType', 'avatarColor', 'coverGradient',
          'avatarUrl', 'coverUrl',
          'followersCount', 'followingCount', 'visitorsCount', 'isOnline', 'showPresence',
          'lastActiveLabel', 'isNewCreator', 'isSuspended', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == uid &&
        isValidId(data.uid) &&
        data.platformId is string && data.platformId.size() >= 3 && data.platformId.size() <= 32 &&
        data.username is string && data.username.size() >= 3 && data.username.size() <= 32 && data.username.matches('^[a-z0-9_]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 64)) &&
        (!('gender' in data) || data.gender in ['Male', 'Female', 'Prefer not to say']) &&
        data.accountType in ['USER', 'AGENT', 'SUPER_AGENT'] &&
        (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 24)) &&
        (!('coverGradient' in data) || (data.coverGradient is string && data.coverGradient.size() <= 160)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 60000)) &&
        (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2048)) &&
        data.followersCount is int && data.followersCount >= 0 &&
        data.followingCount is int && data.followingCount >= 0 &&
        (!('visitorsCount' in data) || (data.visitorsCount is int && data.visitorsCount >= 0)) &&
        data.isOnline is bool &&
        data.showPresence is bool &&
        (!('lastActiveLabel' in data) || (data.lastActiveLabel is string && data.lastActiveLabel.size() <= 48)) &&
        (!('isNewCreator' in data) || data.isNewCreator is bool) &&
        data.isSuspended is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid == uid &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function todayUtc() {
      let m = request.time.month();
      let d = request.time.day();
      return string(request.time.year()) + '-' +
        (m < 10 ? '0' + string(m) : string(m)) + '-' +
        (d < 10 ? '0' + string(d) : string(d));
    }

    function isValidRewardProfile(data, uid) {
      return data.keys().hasAll(['uid', 'day', 'checkInDate', 'streak', 'watchSeconds', 'giftsSent', 'followsMade', 'gamesPlayed', 'claimed', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'day', 'checkInDate', 'streak', 'watchSeconds', 'giftsSent', 'followsMade', 'gamesPlayed', 'claimed', 'updatedAt']) &&
        data.uid == uid &&
        isValidId(data.uid) &&
        data.day is string && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.checkInDate is string &&
        (data.checkInDate == '' || data.checkInDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
        data.streak is int && data.streak >= 0 && data.streak <= 7 &&
        data.watchSeconds is int && data.watchSeconds >= 0 && data.watchSeconds <= 1000000 &&
        data.giftsSent is int && data.giftsSent >= 0 && data.giftsSent <= 100000 &&
        data.followsMade is int && data.followsMade >= 0 && data.followsMade <= 100000 &&
        data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 100000 &&
        data.claimed is list && data.claimed.size() <= 6 &&
        data.claimed.hasOnly(['reward_checkin_' + data.day, 'reward_watch_' + data.day, 'reward_gift_' + data.day, 'reward_follow_' + data.day, 'reward_game_' + data.day]) &&
        data.updatedAt is timestamp;
    }

    function isValidHostRewardProfile(data, uid) {
      return data.keys().hasAll(['uid', 'day', 'liveSeconds', 'giftsReceived', 'newFollowers', 'firstLiveDone', 'validDays', 'claimed', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'day', 'liveSeconds', 'giftsReceived', 'newFollowers', 'firstLiveDone', 'validDays', 'claimed', 'updatedAt']) &&
        data.uid == uid &&
        isValidId(data.uid) &&
        data.day is string && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.liveSeconds is int && data.liveSeconds >= 0 && data.liveSeconds <= 1000000 &&
        data.giftsReceived is int && data.giftsReceived >= 0 && data.giftsReceived <= 100000 &&
        data.newFollowers is int && data.newFollowers >= 0 && data.newFollowers <= 100000 &&
        data.firstLiveDone is bool &&
        data.validDays is int && data.validDays >= 0 && data.validDays <= 1000 &&
        data.claimed is list && data.claimed.size() <= 6 &&
        data.claimed.hasOnly(['host_live30_' + data.day, 'host_live60_' + data.day, 'host_gift_' + data.day, 'host_follow_' + data.day, 'host_valid_' + data.day, 'host_newbie']) &&
        data.updatedAt is timestamp;
    }

    function isValidUsernameDoc(data, username) {
      return data.keys().hasAll(['uid', 'username', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'username', 'createdAt']) &&
        (data.uid == request.auth.uid || isAdmin()) &&
        data.username == username &&
        username.size() >= 3 && username.size() <= 32 && username.matches('^[a-z0-9_]+$') &&
        data.createdAt == request.time;
    }

    function isValidLiveRoom(data, roomId) {
      return data.keys().hasAll([
          'roomId', 'hostUid', 'title', 'category', 'mode', 'status',
          'viewerCount', 'isPrivateFollowersOnly', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomId', 'hostUid', 'title', 'description', 'category', 'mode',
          'status', 'viewerCount', 'isPrivateFollowersOnly', 'isFeatured',
          'thumbnailUrl', 'fallbackGradient', 'seatCount', 'createdAt', 'updatedAt'
        ]) &&
        data.roomId == roomId &&
        isValidId(data.roomId) &&
        isValidId(data.hostUid) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
        (!('seatCount' in data) || data.seatCount in [8, 12, 16, 24]) &&
        data.category in ['Popular', 'Music', 'Entertainment', 'Friendship', 'Chat', 'Gaming', 'Talent', 'New Live'] &&
        data.mode in ['VIDEO', 'AUDIO', 'MULTI_GUEST'] &&
        data.status in ['LIVE', 'ENDED'] &&
        data.viewerCount is int && data.viewerCount >= 0 &&
        data.isPrivateFollowersOnly is bool &&
        (!('isFeatured' in data) || data.isFeatured is bool) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 300)) &&
        (!('fallbackGradient' in data) || (data.fallbackGradient is string && data.fallbackGradient.size() <= 160)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRoomSeat(data, seatId) {
      return seatId.matches('^seat_([1-9]|1[0-9]|2[0-4])$') &&
        data.keys().hasAll(['seatNumber', 'status', 'updatedAt']) &&
        data.keys().hasOnly([
          'seatNumber', 'status', 'occupantUid', 'occupantName',
          'occupantUsername', 'occupantAvatarColor', 'isMuted', 'isSpeaking', 'updatedAt'
        ]) &&
        data.seatNumber is int && data.seatNumber >= 1 && data.seatNumber <= 24 &&
        data.status in ['AVAILABLE', 'REQUESTED', 'OCCUPIED', 'LOCKED'] &&
        (!('occupantUid' in data) || (data.occupantUid is string && data.occupantUid.size() <= 128)) &&
        (!('occupantName' in data) || (data.occupantName is string && data.occupantName.size() <= 64)) &&
        (!('occupantUsername' in data) || (data.occupantUsername is string && data.occupantUsername.size() <= 32)) &&
        (!('occupantAvatarColor' in data) || (data.occupantAvatarColor is string && data.occupantAvatarColor.size() <= 24)) &&
        (!('isMuted' in data) || data.isMuted is bool) &&
        (!('isSpeaking' in data) || data.isSpeaking is bool) &&
        data.updatedAt == request.time;
    }

    function isValidJoinRequest(data, requestId, roomId) {
      return data.keys().hasAll(['requestId', 'roomId', 'uid', 'username', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['requestId', 'roomId', 'uid', 'username', 'displayName', 'avatarColor', 'preferredSeatNumber', 'createdAt']) &&
        data.requestId == requestId &&
        isValidId(data.requestId) &&
        data.roomId == roomId &&
        isValidId(data.roomId) &&
        (data.uid == request.auth.uid || isAdmin()) &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 32 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
        (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 24)) &&
        (!('preferredSeatNumber' in data) || (data.preferredSeatNumber is int && data.preferredSeatNumber >= 1 && data.preferredSeatNumber <= 24)) &&
        data.createdAt == request.time;
    }

    function isValidRoomMessage(data, messageId, roomId) {
      return data.keys().hasAll(['id', 'roomId', 'uid', 'username', 'displayName', 'accountType', 'text', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'roomId', 'uid', 'username', 'displayName', 'accountType', 'text',
          'isGiftEvent', 'giftId', 'giftName', 'giftCurrency', 'giftAmount',
          'giftRecipientUid', 'giftRecipientName', 'giftRecipientDiamonds', 'createdAt'
        ]) &&
        data.id == messageId &&
        isValidId(data.id) &&
        data.roomId == roomId &&
        isValidId(data.roomId) &&
        (data.uid == request.auth.uid || isAdmin()) &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 32 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
        data.accountType in ['USER', 'AGENT', 'SUPER_AGENT'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
        (!('isGiftEvent' in data) || data.isGiftEvent is bool) &&
        (!('giftId' in data) || (data.giftId is string && data.giftId.size() <= 48)) &&
        (!('giftName' in data) || (data.giftName is string && data.giftName.size() <= 48)) &&
        (!('giftCurrency' in data) || data.giftCurrency in ['COIN', 'DIAMOND']) &&
        (!('giftAmount' in data) || (data.giftAmount is int && data.giftAmount > 0)) &&
        (!('giftRecipientUid' in data) || isValidId(data.giftRecipientUid)) &&
        (!('giftRecipientName' in data) || (data.giftRecipientName is string && data.giftRecipientName.size() <= 64)) &&
        (!('giftRecipientDiamonds' in data) || (data.giftRecipientDiamonds is int && data.giftRecipientDiamonds >= 0)) &&
        data.createdAt == request.time;
    }

    // Immutable gift receipt written by the sender. Wallet credits on both the
    // recipient and agency wallets must reference a receipt created here in the
    // same transaction (verified via getAfter + pre-existence checks).
    function isValidGiftEvent(data, eventId) {
      return data.keys().hasAll([
          'eventId', 'contextType', 'contextId', 'senderUid', 'senderUsername', 'recipientUid',
          'recipientUsername', 'recipientDisplayName', 'giftId', 'giftName',
          'giftCurrency', 'giftAmount', 'recipientDiamonds', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'eventId', 'contextType', 'contextId', 'senderUid', 'senderUsername', 'recipientUid',
          'recipientUsername', 'recipientDisplayName', 'giftId', 'giftName',
          'giftCurrency', 'giftAmount', 'recipientDiamonds',
          'luckyValue', 'luckyMultiplier',
          'commissionUid', 'commissionAmount', 'commissionRate', 'createdAt'
        ]) &&
        data.eventId == eventId &&
        isValidId(eventId) &&
        data.contextType in ['ROOM', 'CONVERSATION'] &&
        isValidId(data.contextId) &&
        data.senderUid == request.auth.uid &&
        isValidId(data.recipientUid) &&
        data.senderUid != data.recipientUid &&
        data.senderUsername is string && data.senderUsername.size() >= 1 && data.senderUsername.size() <= 32 &&
        data.recipientUsername is string && data.recipientUsername.size() >= 1 && data.recipientUsername.size() <= 32 &&
        data.recipientDisplayName is string && data.recipientDisplayName.size() >= 1 && data.recipientDisplayName.size() <= 64 &&
        data.giftId is string && data.giftId.size() >= 1 && data.giftId.size() <= 48 &&
        data.giftName is string && data.giftName.size() >= 1 && data.giftName.size() <= 48 &&
        data.giftCurrency in ['COIN', 'DIAMOND'] &&
        data.giftAmount is int && data.giftAmount > 0 && data.giftAmount <= 1000000 &&
        data.recipientDiamonds is int && data.recipientDiamonds >= 0 &&
        (
          // Normal gift: recipient keeps exactly 70% of the paid value.
          (
            data.recipientDiamonds * 10 == data.giftAmount * 7 &&
            !('luckyValue' in data) &&
            !('luckyMultiplier' in data)
          ) ||
          // Lucky open: the sender pays the box price, the recipient keeps 70%
          // of the randomly revealed value. The revealed value is bounded by
          // price x 520 (the top ladder rung) so a forged receipt can never
          // mint more than the biggest possible jackpot.
          (
            data.giftId.matches('^lucky_[a-z]+$') &&
            'luckyValue' in data &&
            data.luckyValue is int && data.luckyValue >= 10 && data.luckyValue <= 1000000 &&
            'luckyMultiplier' in data &&
            data.luckyMultiplier is int && data.luckyMultiplier >= 1 && data.luckyMultiplier <= 5200 &&
            data.luckyValue <= data.giftAmount * 520 &&
            data.recipientDiamonds * 10 == data.luckyValue * 7
          )
        ) &&
        data.createdAt == request.time &&
        (
          (
            data.giftCurrency == 'COIN' &&
            get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.coinBalance -
              getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.coinBalance ==
              data.giftAmount
          ) ||
          (
            data.giftCurrency == 'DIAMOND' &&
            get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance -
              getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance ==
              data.giftAmount
          )
        ) &&
        getAfter(/databases/$(database)/documents/wallets/$(data.recipientUid)).data.diamondBalance -
          get(/databases/$(database)/documents/wallets/$(data.recipientUid)).data.diamondBalance ==
          data.recipientDiamonds &&
        (
          (
            !('commissionUid' in data) &&
            !('commissionAmount' in data) &&
            !('commissionRate' in data)
          ) ||
          (
            isValidId(data.commissionUid) &&
            data.commissionUid != data.senderUid &&
            data.commissionUid != data.recipientUid &&
            data.commissionAmount is int && data.commissionAmount > 0 &&
            data.commissionRate in [5, 10] &&
            data.commissionAmount * 100 == data.giftAmount * data.commissionRate &&
            getAfter(/databases/$(database)/documents/wallets/$(data.commissionUid)).data.diamondBalance -
              get(/databases/$(database)/documents/wallets/$(data.commissionUid)).data.diamondBalance ==
              data.commissionAmount
          )
        );
    }

    function isValidAgencyCommission(data, storyId) {
      return data.keys().hasAll([
          'id', 'eventId', 'superAgentUid', 'memberUid', 'memberUsername',
          'memberDisplayName', 'memberType', 'giftName', 'giftPrice',
          'commissionRate', 'commissionAmount', 'dateKey', 'createdAt', 'timestampMillis'
        ]) &&
        data.keys().hasOnly([
          'id', 'eventId', 'superAgentUid', 'memberUid', 'memberUsername',
          'memberDisplayName', 'memberType', 'giftName', 'giftPrice',
          'commissionRate', 'commissionAmount', 'dateKey', 'createdAt', 'timestampMillis'
        ]) &&
        data.id == storyId &&
        isValidId(storyId) &&
        isValidId(data.eventId) &&
        isValidId(data.superAgentUid) &&
        isValidId(data.memberUid) &&
        data.memberUid != data.superAgentUid &&
        data.memberUsername is string && data.memberUsername.size() >= 1 && data.memberUsername.size() <= 32 &&
        data.memberDisplayName is string && data.memberDisplayName.size() >= 1 && data.memberDisplayName.size() <= 64 &&
        data.memberType in ['AGENT', 'HOST'] &&
        data.giftName is string && data.giftName.size() >= 1 && data.giftName.size() <= 48 &&
        data.giftPrice is int && data.giftPrice > 0 &&
        data.commissionAmount is int && data.commissionAmount > 0 &&
        data.dateKey is string && data.dateKey.size() == 10 &&
        data.timestampMillis is int &&
        data.createdAt == request.time &&
        !exists(/databases/$(database)/documents/giftEvents/$(data.eventId)) &&
        existsAfter(/databases/$(database)/documents/giftEvents/$(data.eventId)) &&
        getAfter(/databases/$(database)/documents/giftEvents/$(data.eventId)).data.senderUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/giftEvents/$(data.eventId)).data.recipientUid == data.memberUid &&
        getAfter(/databases/$(database)/documents/giftEvents/$(data.eventId)).data.commissionUid == data.superAgentUid &&
        getAfter(/databases/$(database)/documents/giftEvents/$(data.eventId)).data.commissionAmount == data.commissionAmount &&
        getAfter(/databases/$(database)/documents/giftEvents/$(data.eventId)).data.giftName == data.giftName &&
        getAfter(/databases/$(database)/documents/giftEvents/$(data.eventId)).data.giftAmount == data.giftPrice;
    }

    function isValidConversation(data, conversationId) {
      return data.keys().hasAll(['conversationId', 'memberUids', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['conversationId', 'memberUids', 'lastMessageText', 'createdAt', 'updatedAt']) &&
        data.conversationId == conversationId &&
        isValidId(data.conversationId) &&
        data.memberUids is list &&
        data.memberUids.size() == 2 &&
        data.memberUids[0] is string && data.memberUids[1] is string &&
        request.auth.uid in data.memberUids &&
        (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDirectMessage(data, messageId) {
      return data.keys().hasAll(['id', 'senderUid', 'memberUids', 'text', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'senderUid', 'memberUids', 'text', 'createdAt',
          'isGiftEvent', 'giftId', 'giftName', 'giftCurrency', 'giftAmount',
          'giftRecipientUid', 'giftRecipientName', 'giftRecipientDiamonds'
        ]) &&
        data.id == messageId &&
        isValidId(data.id) &&
        data.senderUid == request.auth.uid &&
        data.memberUids is list &&
        data.memberUids.size() == 2 &&
        data.memberUids[0] is string && data.memberUids[1] is string &&
        request.auth.uid in data.memberUids &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        (!('isGiftEvent' in data) || data.isGiftEvent is bool) &&
        (!('giftId' in data) || (data.giftId is string && data.giftId.size() <= 48)) &&
        (!('giftName' in data) || (data.giftName is string && data.giftName.size() <= 48)) &&
        (!('giftCurrency' in data) || data.giftCurrency in ['COIN', 'DIAMOND']) &&
        (!('giftAmount' in data) || (data.giftAmount is int && data.giftAmount > 0)) &&
        (!('giftRecipientUid' in data) || isValidId(data.giftRecipientUid)) &&
        (!('giftRecipientName' in data) || (data.giftRecipientName is string && data.giftRecipientName.size() <= 64)) &&
        (!('giftRecipientDiamonds' in data) || (data.giftRecipientDiamonds is int && data.giftRecipientDiamonds >= 0)) &&
        data.createdAt == request.time;
    }

    function isValidWallet(data, uid) {
      return data.keys().hasAll(['uid', 'coinBalance', 'diamondBalance', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'coinBalance', 'diamondBalance', 'tradingCoinBalance', 'lastGiftEventId', 'createdAt', 'updatedAt']) &&
        data.uid == uid &&
        isValidId(data.uid) &&
        data.coinBalance is int && data.coinBalance >= 0 &&
        data.diamondBalance is int && data.diamondBalance >= 0 &&
        (!('tradingCoinBalance' in data) || (data.tradingCoinBalance is int && data.tradingCoinBalance >= 0)) &&
        (!('lastGiftEventId' in data) || isValidId(data.lastGiftEventId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Fruit Manor game ledger keys written by the client:
    //   fm-w-<betId>  winning payout (max stake x highest multiplier = 1,900,000)
    //   fm-r-<key>    refund of a cancelled / voided / late stake (max 100,000)
    function isGameWinKey(key) {
      return key is string && key.matches('^fm-w-.*$');
    }

    function isGameRefundKey(key) {
      return key is string && key.matches('^fm-r-.*$');
    }

    function isValidWalletTransaction(data, txId, uid) {
      return data.keys().hasAll(['transactionId', 'uid', 'currency', 'direction', 'amount', 'reason', 'idempotencyKey', 'createdAt']) &&
        data.keys().hasOnly(['transactionId', 'uid', 'currency', 'direction', 'amount', 'reason', 'counterparty', 'idempotencyKey', 'createdAt']) &&
        data.transactionId == txId &&
        isValidId(data.transactionId) &&
        data.uid == uid &&
        data.currency in ['COIN', 'DIAMOND', 'TRADING'] &&
        data.direction in ['CREDIT', 'DEBIT'] &&
        data.amount is int && data.amount > 0 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 160 &&
        (!('counterparty' in data) || (data.counterparty is string && data.counterparty.size() <= 64)) &&
        data.idempotencyKey is string && data.idempotencyKey.size() >= 1 && data.idempotencyKey.size() <= 128 &&
        data.createdAt == request.time;
    }

    function isValidPromotion(data, promotionId) {
      return data.keys().hasAll(['promotionId', 'actorUid', 'actorUsername', 'targetUid', 'targetUsername', 'beforeType', 'afterType', 'createdAt']) &&
        data.keys().hasOnly(['promotionId', 'actorUid', 'actorUsername', 'targetUid', 'targetUsername', 'beforeType', 'afterType', 'createdAt']) &&
        data.promotionId == promotionId &&
        isValidId(data.promotionId) &&
        data.actorUid == request.auth.uid &&
        data.actorUsername is string && data.actorUsername.size() >= 1 && data.actorUsername.size() <= 32 &&
        isValidId(data.targetUid) &&
        data.targetUsername is string && data.targetUsername.size() >= 1 && data.targetUsername.size() <= 32 &&
        data.beforeType == 'USER' &&
        data.afterType in ['AGENT', 'SUPER_AGENT'] &&
        (data.afterType == 'AGENT' || isBdAgent()) &&
        data.createdAt == request.time;
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll(['reportId', 'targetType', 'targetId', 'targetLabel', 'reason', 'reporterUid', 'reporterUsername', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['reportId', 'targetType', 'targetId', 'targetLabel', 'reason', 'reporterUid', 'reporterUsername', 'status', 'createdAt', 'updatedAt']) &&
        data.reportId == reportId &&
        isValidId(data.reportId) &&
        data.targetType in ['ROOM', 'USER'] &&
        isValidId(data.targetId) &&
        data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 140 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 240 &&
        isValidId(data.reporterUid) &&
        data.reporterUsername is string && data.reporterUsername.size() >= 1 && data.reporterUsername.size() <= 32 &&
        data.status in ['OPEN', 'REVIEWED', 'RESOLVED'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Public creator profiles (zero PII)
    match /counters/platformIds {
      allow get: if isVerifiedUser();
      allow create: if isVerifiedUser() &&
        incoming().keys().hasOnly(['next']) &&
        incoming().next is int &&
        incoming().next == 112202;
      allow update: if isVerifiedUser() &&
        incoming().keys().hasOnly(['next']) &&
        incoming().next is int &&
        incoming().next == existing().next + 1;
    }

    match /users/{uid} {
      allow get: if isValidId(uid);
      allow list: if resource.data.isSuspended == false || isAdmin();
      allow delete: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidUserPublic(incoming(), uid) &&
        incoming().isSuspended == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ((isOwner(uid) && incoming().accountType == 'USER') ||
          isAdmin() ||
          (isOwner(uid) &&
            incoming().accountType == 'SUPER_AGENT' &&
            request.auth.token.email in ['ranababu78@gmail.com']));
      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidUserPublic(incoming(), uid) &&
        incoming().uid == existing().uid &&
        (isAdmin() || incoming().platformId == existing().platformId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(uid) &&
            incoming().accountType == existing().accountType &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'username', 'bio', 'country', 'gender',
              'avatarColor', 'coverGradient', 'avatarUrl', 'coverUrl',
              'isOnline', 'showPresence',
              'lastActiveLabel', 'followingCount', 'updatedAt'
            ])
          ) ||
          (
            isSuperAgent() &&
            existing().accountType == 'USER' &&
            incoming().accountType == 'AGENT' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['accountType', 'updatedAt'])
          ) ||
          (
            isBdAgent() &&
            existing().accountType == 'USER' &&
            incoming().accountType == 'SUPER_AGENT' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['accountType', 'updatedAt'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt']) &&
            (incoming().followersCount == existing().followersCount + 1 || incoming().followersCount == existing().followersCount - 1)
          ) ||
          (
            isSignedIn() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['visitorsCount', 'updatedAt']) &&
            incoming().visitorsCount == existing().get('visitorsCount', 0) + 1
          )
        );
    }

    // Profile wall (cover) images stored inline as compressed data URLs
    match /userCovers/{uid} {
      allow get: if isValidId(uid) && isSignedIn();
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.dataUrl is string &&
        request.resource.data.dataUrl.size() <= 900000 &&
        request.resource.data.dataUrl.matches('^data:image/jpeg;base64,.+') &&
        request.resource.data.updatedAt == request.time;
    }

    // Profile visitor log — each visitor writes only their own entry; the
    // profile owner (or admin) can read the list that powers the Visitor stat.
    match /profileVisits/{ownerUid} {
      allow read, write: if false;
      match /visitors/{visitorUid} {
        allow read: if isValidId(ownerUid) && (isOwner(ownerUid) || isAdmin());
        allow create, update: if isVerifiedUser() &&
          request.auth.uid == visitorUid &&
          visitorUid != ownerUid &&
          request.resource.data.visitorUid == visitorUid &&
          request.resource.data.visitedAt == request.time;
        allow delete: if isAdmin();
      }
    }

    // Owner-only PII
    match /userPrivate/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
      allow create: if isVerifiedUser() &&
        isOwner(uid) &&
        isValidUserPrivate(incoming(), uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        (isOwner(uid) || isAdmin()) &&
        isValidUserPrivate(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
    }

    // Reward Center: daily check-in + task progress (owner-managed, bounded)
    match /rewardProfiles/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
      allow create: if isVerifiedUser() &&
        isOwner(uid) &&
        isValidRewardProfile(incoming(), uid) &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isOwner(uid) &&
        isValidRewardProfile(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        (
          incoming().day != existing().day ||
          incoming().claimed.hasAll(existing().claimed)
        );
    }

    // Host Rewards (Poppo-style female host rewards, paid in Diamonds)
    match /hostRewardProfiles/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
      allow create: if isVerifiedUser() &&
        isOwner(uid) &&
        isValidHostRewardProfile(incoming(), uid) &&
        get(/databases/$(database)/documents/users/$(uid)).data.gender == 'Female' &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isOwner(uid) &&
        isValidHostRewardProfile(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        get(/databases/$(database)/documents/users/$(uid)).data.gender == 'Female' &&
        (existing().firstLiveDone == false || incoming().firstLiveDone == true) &&
        (
          (
            incoming().day == existing().day &&
            incoming().claimed.hasAll(existing().claimed) &&
            incoming().liveSeconds >= existing().liveSeconds &&
            incoming().giftsReceived >= existing().giftsReceived &&
            incoming().newFollowers >= existing().newFollowers &&
            (
              (
                incoming().claimed.hasAny(['host_valid_' + incoming().day]) &&
                !existing().claimed.hasAny(['host_valid_' + incoming().day]) &&
                incoming().validDays == existing().validDays - 5
              ) ||
              incoming().validDays == existing().validDays
            )
          ) ||
          (
            incoming().day != existing().day &&
            incoming().validDays == existing().validDays + (existing().liveSeconds >= 3600 ? 1 : 0)
          )
        );
    }

    // Username uniqueness index
    match /usernames/{username} {
      allow get: if username is string && username.size() >= 3 && username.size() <= 32;
      allow delete: if isAdmin();
      allow create: if isVerifiedUser() &&
        !exists(/databases/$(database)/documents/usernames/$(username)) &&
        isValidUsernameDoc(incoming(), username);
    }

    // Follows
    match /follows/{followId} {
      allow get: if isValidId(followId) && isSignedIn();
      allow list: if isSignedIn() && (resource.data.followerUid == request.auth.uid || resource.data.targetUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(followId) &&
        incoming().keys().hasAll(['followerUid', 'targetUid', 'createdAt']) &&
        incoming().keys().hasOnly(['followerUid', 'targetUid', 'createdAt']) &&
        incoming().followerUid == request.auth.uid &&
        isValidId(incoming().targetUid) &&
        incoming().targetUid != request.auth.uid &&
        incoming().createdAt == request.time;
      allow delete: if isVerifiedUser() && isValidId(followId) && (existing().followerUid == request.auth.uid || isAdmin());
    }

    // Blocks
    match /blocks/{blockId} {
      allow get: if isValidId(blockId) && isSignedIn() && existing().blockerUid == request.auth.uid;
      allow list: if isSignedIn() && (resource.data.blockerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(blockId) &&
        incoming().keys().hasAll(['blockerUid', 'blockedUid', 'createdAt']) &&
        incoming().keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt']) &&
        incoming().blockerUid == request.auth.uid &&
        isValidId(incoming().blockedUid) &&
        incoming().blockedUid != request.auth.uid &&
        incoming().createdAt == request.time;
      allow delete: if isVerifiedUser() && isValidId(blockId) && (existing().blockerUid == request.auth.uid || isAdmin());
    }

    // Live Rooms
    match /liveRooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if resource.data.status == 'LIVE' &&
        (resource.data.isPrivateFollowersOnly == false || (isSignedIn() && resource.data.hostUid == request.auth.uid));
      allow create: if isVerifiedUser() &&
        isValidId(roomId) &&
        isValidLiveRoom(incoming(), roomId) &&
        (incoming().hostUid == request.auth.uid || isAdmin()) &&
        incoming().status == 'LIVE' &&
        incoming().viewerCount >= 1 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(roomId) &&
        isValidLiveRoom(incoming(), roomId) &&
        incoming().roomId == existing().roomId &&
        incoming().hostUid == existing().hostUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (incoming().status == existing().status || existing().hostUid == request.auth.uid || isAdmin()) &&
        (existing().status != 'ENDED' || isAdmin()) && (
          isAdmin() ||
          (
            existing().hostUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'viewerCount', 'updatedAt'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['viewerCount', 'updatedAt']) &&
            (incoming().viewerCount == existing().viewerCount + 1 || incoming().viewerCount == existing().viewerCount - 1)
          )
        );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.hostUid == request.auth.uid);

      // Multi-guest seats (8 / 12 / 16 / 24 capacity)
      match /seats/{seatId} {
        allow get: if isValidId(roomId) && isValidId(seatId);
        allow list: if resource.data.seatNumber >= 1 && resource.data.seatNumber <= 24;
        allow delete: if isAdmin();
        allow create: if isVerifiedUser() &&
          (isRoomHostAfter(roomId) || isAdmin()) &&
          isValidRoomSeat(incoming(), seatId);
        allow update: if isVerifiedUser() &&
          isValidRoomSeat(incoming(), seatId) &&
          incoming().seatNumber == existing().seatNumber && (
            isRoomHost(roomId) ||
            isAdmin() ||
            (
              existing().status == 'AVAILABLE' &&
              incoming().status == 'REQUESTED' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            ) ||
            (
              existing().status == 'OCCUPIED' &&
              existing().occupantUid == request.auth.uid &&
              incoming().status == 'AVAILABLE' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'occupantUid', 'occupantName', 'occupantUsername', 'occupantAvatarColor', 'isMuted', 'isSpeaking', 'updatedAt'])
            )
          );
      }

      // Guest Seat Join Requests
      match /joinRequests/{requestId} {
        allow get: if isValidId(roomId) && isValidId(requestId) && isSignedIn();
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow delete: if isAdmin();
        allow create: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(requestId) &&
          exists(/databases/$(database)/documents/liveRooms/$(roomId)) &&
          isValidJoinRequest(incoming(), requestId, roomId);
        allow delete: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(requestId) &&
          (existing().uid == request.auth.uid || isRoomHost(roomId) || isAdmin());
      }

      // WebRTC broadcast signaling (host <-> viewer peer connection setup)
      match /rtc/{viewerUid} {
        allow get: if isValidId(roomId) && isValidId(viewerUid) && isSignedIn();
        allow list: if isValidId(roomId) && isSignedIn();
        allow create: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(viewerUid) &&
          isOwner(viewerUid) &&
          exists(/databases/$(database)/documents/liveRooms/$(roomId)) &&
          get(/databases/$(database)/documents/liveRooms/$(roomId)).data.status == 'LIVE' &&
          incoming().keys().hasOnly(['viewerUid', 'createdAt']) &&
          incoming().viewerUid == viewerUid &&
          incoming().createdAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(viewerUid) &&
          (isOwner(viewerUid) || isRoomHost(roomId) || isAdmin()) &&
          incoming().keys().hasOnly(['viewerUid', 'offer', 'answer', 'hostCandidates', 'viewerCandidates', 'createdAt']) &&
          incoming().viewerUid == existing().viewerUid;
        allow delete: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(viewerUid) &&
          (isOwner(viewerUid) || isRoomHost(roomId) || isAdmin());
      }

      // WebRTC guest-seat signaling: guestRtc/{guestUid}__{viewerUid}
      match /guestRtc/{signalId} {
        allow get: if isValidId(roomId) && isValidId(signalId) && isSignedIn();
        allow list: if isValidId(roomId) && isSignedIn();
        allow create: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(signalId) &&
          signalId.split('__').size() == 2 &&
          isValidId(signalId.split('__')[0]) &&
          isValidId(signalId.split('__')[1]) &&
          isOwner(signalId.split('__')[1]) &&
          exists(/databases/$(database)/documents/liveRooms/$(roomId)) &&
          get(/databases/$(database)/documents/liveRooms/$(roomId)).data.status == 'LIVE' &&
          incoming().keys().hasOnly(['viewerUid', 'createdAt']) &&
          incoming().viewerUid == signalId.split('__')[1] &&
          incoming().createdAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(signalId) &&
          signalId.split('__').size() == 2 &&
          (isOwner(signalId.split('__')[1]) ||
            request.auth.uid == signalId.split('__')[0] ||
            isRoomHost(roomId) || isAdmin()) &&
          incoming().keys().hasOnly(['viewerUid', 'offer', 'answer', 'hostCandidates', 'viewerCandidates', 'createdAt']) &&
          incoming().viewerUid == existing().viewerUid;
        allow delete: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(signalId) &&
          signalId.split('__').size() == 2 &&
          (isOwner(signalId.split('__')[1]) ||
            request.auth.uid == signalId.split('__')[0] ||
            isRoomHost(roomId) || isAdmin());
      }

      // Live Room Chat & Gift Events
      match /messages/{messageId} {
        allow get: if isValidId(roomId) && isValidId(messageId);
        allow list: if resource.data.roomId == roomId;
        allow delete: if isAdmin();
        allow create: if isVerifiedUser() &&
          isValidId(roomId) &&
          isValidId(messageId) &&
          exists(/databases/$(database)/documents/liveRooms/$(roomId)) &&
          get(/databases/$(database)/documents/liveRooms/$(roomId)).data.status == 'LIVE' &&
          isValidRoomMessage(incoming(), messageId, roomId);
      }
    }

    // Gift receipts — security anchor for gifting wallet credits.
    match /giftEvents/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId);
      allow list: if isSignedIn();
      allow create: if isVerifiedUser() &&
        isValidId(eventId) &&
        isValidGiftEvent(incoming(), eventId) &&
        !exists(/databases/$(database)/documents/giftEvents/$(eventId));
      allow update, delete: if isAdmin();
    }

    // Agency commission stories (30-day retention ledger).
    match /agencyCommissions/{storyId} {
      allow get: if isValidId(storyId) &&
        (isAdmin() || isSuperAgent() || (isSignedIn() && resource.data.memberUid == request.auth.uid));
      allow list: if isAdmin() || isSuperAgent() ||
        (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidAgencyCommission(incoming(), storyId);
      allow update, delete: if isAdmin();
    }

    // Private Conversations
    match /conversations/{conversationId} {
      // Allow "does this conversation exist?" probes on a not-yet-created doc
      // (resource == null). Without this branch ensureConversationDoc cannot
      // check for an existing thread and conversation creation fails closed.
      allow get: if isValidId(conversationId) && isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.memberUids || isAdmin());
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow delete: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(conversationId) &&
        isValidConversation(incoming(), conversationId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(conversationId) &&
        isValidConversation(incoming(), conversationId) &&
        incoming().conversationId == existing().conversationId &&
        incoming().memberUids == existing().memberUids &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'updatedAt']);

      match /messages/{messageId} {
        allow delete: if isAdmin();
        allow get: if isValidId(conversationId) &&
          isValidId(messageId) &&
          isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
        allow create: if isVerifiedUser() &&
          isValidId(conversationId) &&
          isValidId(messageId) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids &&
          incoming().memberUids == get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids &&
          isValidDirectMessage(incoming(), messageId);
      }
    }

    // Fruit Manor shared board: one round for every player at the same time.
    // A short leader lease decides which client advances the phase clock.
    function isFmFruit(f) {
      return f == null || f in ['strawberry', 'apple', 'banana', 'orange', 'grapes', 'cherries', 'watermelon', 'plum'];
    }

    function isValidFmBoard(data) {
      return data.keys().hasAll([
          'roundId', 'seq', 'configVersion', 'phase', 'phaseEndsAt', 'resultFruitId',
          'recentResults', 'leaderUid', 'leaderLeaseUntil', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roundId', 'seq', 'configVersion', 'phase', 'phaseEndsAt', 'resultFruitId',
          'recentResults', 'leaderUid', 'leaderLeaseUntil', 'createdAt', 'updatedAt'
        ]) &&
        data.roundId is string && data.roundId.matches('^FM-[0-9]{1,9}$') &&
        data.seq is int && data.seq >= 1 && data.seq <= 999999999 &&
        data.configVersion is string && data.configVersion.size() >= 1 && data.configVersion.size() <= 32 &&
        data.phase in ['SCHEDULED', 'OPEN', 'LOCKED', 'DRAWN', 'SETTLING', 'SETTLED', 'VOIDED'] &&
        data.phaseEndsAt is timestamp &&
        isFmFruit(data.resultFruitId) &&
        data.recentResults is list && data.recentResults.size() <= 30 &&
        isFmValidId(data.leaderUid) &&
        data.leaderLeaseUntil is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isFmValidId(value) {
      return value is string && value.size() >= 1 && value.size() <= 128 && value.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFmBet(data, betId) {
      return data.keys().hasAll([
          'betId', 'roundId', 'uid', 'username', 'fruitId', 'stake', 'multiplier',
          'status', 'payout', 'debitRef', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'betId', 'roundId', 'uid', 'username', 'fruitId', 'stake', 'multiplier',
          'status', 'payout', 'debitRef', 'creditRef', 'createdAt', 'settledAt'
        ]) &&
        data.betId == betId &&
        isFmValidId(data.betId) &&
        data.roundId is string && data.roundId.matches('^FM-[0-9]{1,9}$') &&
        data.uid is string && data.uid == request.auth.uid &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 32 &&
        data.fruitId in ['strawberry', 'apple', 'banana', 'orange', 'grapes', 'cherries', 'watermelon', 'plum'] &&
        data.stake is int && data.stake >= 10 && data.stake <= 50000 &&
        data.multiplier is int && data.multiplier >= 3 && data.multiplier <= 38 &&
        data.status == 'ACCEPTED' &&
        data.payout is int && data.payout == 0 &&
        data.debitRef is string && data.debitRef.size() >= 1 && data.debitRef.size() <= 128 &&
        (!('creditRef' in data) || (data.creditRef is string && data.creditRef.size() <= 128)) &&
        data.createdAt == request.time;
    }

    match /fruitManor/{boardId} {
      allow get, list: if isSignedIn();
      allow create: if isVerifiedUser() &&
        boardId == 'board' &&
        isValidFmBoard(incoming()) &&
        incoming().leaderUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        boardId == 'board' &&
        isValidFmBoard(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (incoming().leaderUid == existing().leaderUid && existing().leaderUid == request.auth.uid) ||
          (incoming().leaderUid == request.auth.uid && existing().leaderLeaseUntil <= request.time)
        );
      allow delete: if false;
    }

    // Public bet slips for the shared round — everyone sees the whole pool.
    match /fruitManorBets/{betId} {
      allow get, list: if isSignedIn();
      allow create: if isVerifiedUser() &&
        isValidFmBet(incoming(), betId) &&
        exists(/databases/$(database)/documents/fruitManor/board) &&
        get(/databases/$(database)/documents/fruitManor/board).data.roundId == incoming().roundId &&
        get(/databases/$(database)/documents/fruitManor/board).data.phase == 'OPEN';
      allow update: if isVerifiedUser() &&
        isFmValidId(betId) &&
        existing().uid == request.auth.uid &&
        incoming().betId == existing().betId &&
        incoming().roundId == existing().roundId &&
        incoming().uid == existing().uid &&
        incoming().stake == existing().stake &&
        incoming().multiplier == existing().multiplier &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'payout', 'creditRef', 'settledAt']) &&
        incoming().status in ['WON', 'LOST', 'REFUNDED'] &&
        incoming().payout is int && incoming().payout >= 0 && incoming().payout <= 1900000 &&
        incoming().settledAt == request.time;
      allow delete: if false;
    }

    // Golden Flower: Poppo-style shared seat-betting board (same trust model
    // as Fruit Manor). One round document with a leader lease, public seat bet
    // slips, idempotent per-player settlement.
    function isGfValidId(value) {
      return value is string && value.size() >= 1 && value.size() <= 128 && value.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isGfCard(c) {
      return c is map && c.keys().hasOnly(['id', 'suit', 'rank']) &&
        c.id is string && c.id.size() <= 8 &&
        c.suit in ['S', 'H', 'D', 'C'] &&
        c.rank is int && c.rank >= 2 && c.rank <= 14;
    }

    function isGfCards(cards) {
      return cards is list && cards.size() == 3 &&
        isGfCard(cards[0]) && isGfCard(cards[1]) && isGfCard(cards[2]);
    }

    function isValidGfBoard(data) {
      return data.keys().hasAll([
          'roundId', 'seq', 'configVersion', 'phase', 'phaseEndsAt', 'seatCards',
          'seatCats', 'winnerSeat', 'recentResults', 'leaderUid', 'leaderLeaseUntil',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roundId', 'seq', 'configVersion', 'phase', 'phaseEndsAt', 'seatCards',
          'seatCats', 'winnerSeat', 'recentResults', 'leaderUid', 'leaderLeaseUntil',
          'createdAt', 'updatedAt'
        ]) &&
        data.roundId is string && data.roundId.matches('^GF-[0-9]{1,9}$') &&
        data.seq is int && data.seq >= 1 && data.seq <= 999999999 &&
        data.configVersion is string && data.configVersion.size() >= 1 && data.configVersion.size() <= 32 &&
        data.phase in ['OPEN', 'LOCKED', 'DRAWN', 'SETTLED', 'VOIDED'] &&
        data.phaseEndsAt is timestamp &&
        (data.seatCards == null || (
          data.seatCards is map && data.seatCards.keys().hasOnly(['0', '1', '2']) &&
          isGfCards(data.seatCards['0']) && isGfCards(data.seatCards['1']) && isGfCards(data.seatCards['2'])
        )) &&
        (data.seatCats == null || (
          data.seatCats is map && data.seatCats.keys().hasOnly(['0', '1', '2']) &&
          data.seatCats['0'] is string && data.seatCats['0'].size() <= 40 &&
          data.seatCats['1'] is string && data.seatCats['1'].size() <= 40 &&
          data.seatCats['2'] is string && data.seatCats['2'].size() <= 40
        )) &&
        (data.winnerSeat == null || (data.winnerSeat is int && data.winnerSeat >= 0 && data.winnerSeat <= 2)) &&
        data.recentResults is list && data.recentResults.size() <= 30 &&
        isGfValidId(data.leaderUid) &&
        data.leaderLeaseUntil is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGfBet(data, betId) {
      return data.keys().hasAll([
          'betId', 'roundId', 'uid', 'username', 'seat', 'stake',
          'status', 'payout', 'debitRef', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'betId', 'roundId', 'uid', 'username', 'seat', 'stake',
          'status', 'payout', 'debitRef', 'creditRef', 'createdAt', 'settledAt'
        ]) &&
        data.betId == betId &&
        isGfValidId(data.betId) &&
        data.roundId is string && data.roundId.matches('^GF-[0-9]{1,9}$') &&
        data.uid is string && data.uid == request.auth.uid &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 32 &&
        data.seat is int && data.seat >= 0 && data.seat <= 2 &&
        data.stake is int && data.stake in [10, 100, 1000, 5000, 50000] &&
        data.status == 'ACCEPTED' &&
        data.payout is int && data.payout == 0 &&
        data.debitRef is string && data.debitRef.size() >= 1 && data.debitRef.size() <= 128 &&
        (!('creditRef' in data) || (data.creditRef is string && data.creditRef.size() <= 128)) &&
        data.createdAt == request.time;
    }

    match /gf_config/{configId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && configId == 'config';
      allow delete: if false;
    }

    match /gf_admin_audit/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
        incoming().uid == request.auth.uid &&
        incoming().summary is string && incoming().summary.size() <= 240 &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Shared round board: one document, leader-lease phase clock.
    match /gf_board/{boardId} {
      allow get, list: if isSignedIn();
      allow create: if isVerifiedUser() &&
        boardId == 'board' &&
        isValidGfBoard(incoming()) &&
        incoming().leaderUid == request.auth.uid &&
        incoming().phase == 'OPEN' &&
        incoming().seatCards == null && incoming().seatCats == null && incoming().winnerSeat == null &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        boardId == 'board' &&
        isValidGfBoard(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (incoming().leaderUid == existing().leaderUid && existing().leaderUid == request.auth.uid) ||
          (incoming().leaderUid == request.auth.uid && existing().leaderLeaseUntil <= request.time)
        );
      allow delete: if false;
    }

    // Public seat bet slips — everyone sees each seat's Pot; each player
    // settles only their own slips.
    match /gf_bets/{betId} {
      allow get, list: if isSignedIn();
      allow create: if isVerifiedUser() &&
        isValidGfBet(incoming(), betId) &&
        exists(/databases/$(database)/documents/gf_board/board) &&
        get(/databases/$(database)/documents/gf_board/board).data.roundId == incoming().roundId &&
        get(/databases/$(database)/documents/gf_board/board).data.phase == 'OPEN';
      allow update: if isVerifiedUser() &&
        isGfValidId(betId) &&
        existing().uid == request.auth.uid &&
        incoming().betId == existing().betId &&
        incoming().roundId == existing().roundId &&
        incoming().uid == existing().uid &&
        incoming().seat == existing().seat &&
        incoming().stake == existing().stake &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'payout', 'creditRef', 'settledAt']) &&
        incoming().status in ['WON', 'LOST', 'REFUNDED'] &&
        incoming().payout is int && incoming().payout >= 0 && incoming().payout <= 149000 &&
        incoming().settledAt == request.time;
      allow delete: if false;
    }

    // Wallets (Coins & Diamonds — No Top-Up, No Client Inflation)
    match /wallets/{uid} {
      allow get: if isValidId(uid) && (
        isOwner(uid) ||
        isAdmin() ||
        isSuperAgent() ||
        (isAgent() && isUserWallet(uid))
      );
      allow list: if isAdmin();
      allow delete: if isAdmin();
      allow create: if isVerifiedUser() &&
        isOwner(uid) &&
        isValidWallet(incoming(), uid) &&
        incoming().coinBalance == 500 &&
        incoming().diamondBalance == 120 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidWallet(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            // Agency sender debits their own Coins Trading Balance.
            isOwner(uid) &&
            (isBdAgent() || isSuperAgent() || isAgent()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['tradingCoinBalance', 'updatedAt']) &&
            incoming().tradingCoinBalance < existing().tradingCoinBalance
          ) ||
          (
            // Coins Exchange: own Trading Balance -> own Main Balance (1:1, no fee).
            isOwner(uid) &&
            (isBdAgent() || isSuperAgent() || isAgent()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['tradingCoinBalance', 'coinBalance', 'updatedAt']) &&
            incoming().tradingCoinBalance < existing().tradingCoinBalance &&
            incoming().coinBalance > existing().coinBalance &&
            (incoming().coinBalance - existing().coinBalance) <=
              (existing().tradingCoinBalance - incoming().tradingCoinBalance)
          ) ||
          (
            // Self Diamonds Withdraw: own Diamonds -> own Trading Balance.
            // Trading credit may never exceed 90% of the diamond debit (10% fee).
            // Minimum withdrawal: 100,000 diamonds.
            isOwner(uid) &&
            (isBdAgent() || isSuperAgent() || isAgent()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['diamondBalance', 'tradingCoinBalance', 'updatedAt']) &&
            incoming().diamondBalance < existing().diamondBalance &&
            existing().diamondBalance - incoming().diamondBalance >= 100000 &&
            incoming().tradingCoinBalance > existing().tradingCoinBalance &&
            (incoming().tradingCoinBalance - existing().tradingCoinBalance) * 100 <=
              (existing().diamondBalance - incoming().diamondBalance) * 90
          ) ||
          (
            // Diamonds Withdraw to an Agent: the owner's diamond balance
            // decreases (minimum 100,000). The agent-side credit and both
            // transaction docs are validated by their own rules in the same
            // transaction.
            isOwner(uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['diamondBalance', 'updatedAt']) &&
            incoming().diamondBalance < existing().diamondBalance &&
            existing().diamondBalance - incoming().diamondBalance >= 100000
          ) ||
          (
            // Diamonds Withdraw -> agent Trading Balance: any verified user's
            // same-batch diamond debit (>= 100,000) funds this credit, at most
            // 97% of it (3% platform fee).
            uid != request.auth.uid &&
            isAgencyWallet(uid) &&
            isVerifiedUser() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['tradingCoinBalance', 'updatedAt']) &&
            incoming().tradingCoinBalance > existing().tradingCoinBalance &&
            getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance <
              get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance &&
            (
              get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance -
              getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance
            ) >= 100000 &&
            (incoming().tradingCoinBalance - existing().tradingCoinBalance) * 100 <=
              (
                get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance -
                getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance
              ) * 97
          ) ||
          (
            // Admin / BD Agent / Super Agent credits an agency recipient's Trading Balance.
            uid != request.auth.uid &&
            isAgencyWallet(uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['tradingCoinBalance', 'updatedAt']) &&
            incoming().tradingCoinBalance > existing().tradingCoinBalance &&
            (
              isBdAgent() ||
              (isSuperAgent() && isBdAgent() == false && isAgentWallet(uid))
            )
          ) ||
          (
            // Super Agent / Agent credits a User's Main Balance.
            uid != request.auth.uid &&
            isUserWallet(uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'updatedAt']) &&
            incoming().coinBalance > existing().coinBalance &&
            (isAgent() || (isSuperAgent() && isBdAgent() == false))
          ) ||
          (
            // Gift credit to the recipient / agency. The wallet must reference a
            // gift receipt created in this same transaction, and the credited
            // amount must match the receipt exactly. Pre-existence is rejected,
            // so a receipt can never be replayed.
            uid != request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['diamondBalance', 'lastGiftEventId', 'updatedAt']) &&
            incoming().diamondBalance > existing().diamondBalance &&
            incoming().lastGiftEventId is string &&
            isValidId(incoming().lastGiftEventId) &&
            !exists(/databases/$(database)/documents/giftEvents/$(incoming().lastGiftEventId)) &&
            existsAfter(/databases/$(database)/documents/giftEvents/$(incoming().lastGiftEventId)) &&
            getAfter(/databases/$(database)/documents/giftEvents/$(incoming().lastGiftEventId)).data.senderUid == request.auth.uid &&
            (
              (
                getAfter(/databases/$(database)/documents/giftEvents/$(incoming().lastGiftEventId)).data.recipientUid == uid &&
                incoming().diamondBalance - existing().diamondBalance ==
                  getAfter(/databases/$(database)/documents/giftEvents/$(incoming().lastGiftEventId)).data.recipientDiamonds
              ) ||
              (
                getAfter(/databases/$(database)/documents/giftEvents/$(incoming().lastGiftEventId)).data.commissionUid == uid &&
                incoming().diamondBalance - existing().diamondBalance ==
                  getAfter(/databases/$(database)/documents/giftEvents/$(incoming().lastGiftEventId)).data.commissionAmount
              )
            )
          ) ||
          (
            // Fruit Manor pays winnings / refunds back into the owner's own
            // wallet. Bounded by the largest possible single game payout
            // (maxStakePerBet 50,000 x top multiplier 38 = 1,900,000).
            isOwner(uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'updatedAt']) &&
            incoming().coinBalance > existing().coinBalance &&
            incoming().coinBalance - existing().coinBalance <= 1900000
          ) ||
          (
            // Coins -> Diamonds conversion: the owner trades Main Coins for
            // Diamonds at the 70% yield (30% fee). Diamonds minted may never
            // exceed 70% of the coins spent.
            isOwner(uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'diamondBalance', 'updatedAt']) &&
            incoming().coinBalance < existing().coinBalance &&
            incoming().diamondBalance > existing().diamondBalance &&
            (incoming().diamondBalance - existing().diamondBalance) * 10 <=
              (existing().coinBalance - incoming().coinBalance) * 7
          ) ||
          (
            // Host Reward Center: female hosts earn Diamonds. The credit must
            // coincide with a reward claim in the same transaction (claimed
            // list grows or 5 valid days are redeemed) and never exceed 5,000.
            isOwner(uid) &&
            get(/databases/$(database)/documents/users/$(uid)).data.gender == 'Female' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['diamondBalance', 'updatedAt']) &&
            incoming().diamondBalance > existing().diamondBalance &&
            incoming().diamondBalance - existing().diamondBalance <= 5000 &&
            getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.day == todayUtc() &&
            (
              getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.claimed.size() >
                get(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.claimed.size() ||
              getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.validDays ==
                get(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.validDays - 5
            )
          ) ||
          (
            isOwner(uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'diamondBalance', 'updatedAt']) &&
            incoming().coinBalance <= existing().coinBalance &&
            incoming().diamondBalance <= existing().diamondBalance &&
            (incoming().coinBalance < existing().coinBalance || incoming().diamondBalance < existing().diamondBalance)
          )
        );

      match /transactions/{transactionId} {
        allow get: if isValidId(uid) && isValidId(transactionId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) || isAdmin();
        allow delete: if isAdmin();
        allow create: if isVerifiedUser() &&
          isValidId(uid) &&
          isValidId(transactionId) &&
          isValidWalletTransaction(incoming(), transactionId, uid) && (
            isAdmin() ||
            (
              // Agency transfer credit: recipient must match the sender hierarchy
              // (BD Agent -> agency, Super Agent -> Agent/User, Agent -> User).
              uid != request.auth.uid &&
              incoming().direction == 'CREDIT' &&
              (
                (isBdAgent() && isAgencyWallet(uid)) ||
                (isSuperAgent() && isBdAgent() == false && (isAgentWallet(uid) || isUserWallet(uid))) ||
                (isAgent() && isUserWallet(uid))
              )
            ) ||
            (
              // Gift ledger credit for the recipient or agency. Must reference
              // the brand-new gift receipt created in this transaction.
              uid != request.auth.uid &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'DIAMOND' &&
              incoming().idempotencyKey.matches('^gift_.*$') &&
              !exists(/databases/$(database)/documents/giftEvents/$(incoming().idempotencyKey)) &&
              existsAfter(/databases/$(database)/documents/giftEvents/$(incoming().idempotencyKey)) &&
              getAfter(/databases/$(database)/documents/giftEvents/$(incoming().idempotencyKey)).data.senderUid == request.auth.uid &&
              (
                (
                  getAfter(/databases/$(database)/documents/giftEvents/$(incoming().idempotencyKey)).data.recipientUid == uid &&
                  incoming().amount ==
                    getAfter(/databases/$(database)/documents/giftEvents/$(incoming().idempotencyKey)).data.recipientDiamonds
                ) ||
                (
                  getAfter(/databases/$(database)/documents/giftEvents/$(incoming().idempotencyKey)).data.commissionUid == uid &&
                  incoming().amount ==
                    getAfter(/databases/$(database)/documents/giftEvents/$(incoming().idempotencyKey)).data.commissionAmount
                )
              )
            ) ||
            (
              isOwner(uid) &&
              incoming().direction == 'DEBIT' &&
              (
                incoming().currency != 'DIAMOND' ||
                !incoming().reason.matches('.*[Ww]ithdraw.*') ||
                incoming().amount >= 100000
              )
            ) ||
            (
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().amount <= 500 &&
              incoming().idempotencyKey.matches('^welcome_grant_.*$')
            ) ||
            (
              // Fruit Manor payouts: the credited amount must equal the exact
              // wallet increase committed in the same transaction.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'COIN' &&
              (
                (isGameWinKey(incoming().idempotencyKey) && incoming().amount <= 1900000) ||
                (isGameRefundKey(incoming().idempotencyKey) && incoming().amount <= 100000)
              ) &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance
            ) ||
            (
              // Golden Flower seat payouts / refunds. Max win = 50,000 chip
              // x 2.98 = 149,000; a refund never exceeds the 50,000 chip.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'COIN' &&
              (
                (incoming().idempotencyKey.matches('^gf-w-.*$') && incoming().amount <= 149000) ||
                (incoming().idempotencyKey.matches('^gf-r-.*$') && incoming().amount <= 50000)
              ) &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance
            ) ||
            (
              // Instant arcade payouts / refunds (Coin Flip, Bingo, Plinko,
              // Crash, Mines, Hi-Lo, Roulette). Key names the game round;
              // wins stay within the shared 1,900,000 max payout and refunds
              // never exceed the 5,000 top stake.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'COIN' &&
              (
                (incoming().idempotencyKey.matches('^(cf|bb|pl|cr|mn|hl|rl)-[A-Z0-9]+-w$') && incoming().amount <= 1900000) ||
                (incoming().idempotencyKey.matches('^(mn|hl)-[A-Z0-9]+-r$') && incoming().amount <= 5000)
              ) &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance
            ) ||
            (
              // Coins Exchange credit: must equal the exact main-balance increase
              // committed in the same transaction.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'COIN' &&
              incoming().idempotencyKey.matches('^tx_ex_c_.*$') &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance
            ) ||
            (
              // Self Diamonds Withdraw credit: must equal the exact trading-balance
              // increase committed in the same transaction.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'COIN' &&
              incoming().idempotencyKey.matches('^tx_wself_c_.*$') &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.tradingCoinBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.tradingCoinBalance
            ) ||
            (
              // Reward Center claims: once per task per UTC day, exact configured
              // amount, progress verified, and exact main-balance increase.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'COIN' &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance &&
              getAfter(/databases/$(database)/documents/rewardProfiles/$(uid)).data.day == todayUtc() &&
              !get(/databases/$(database)/documents/rewardProfiles/$(uid)).data.claimed.hasAny([incoming().idempotencyKey]) &&
              getAfter(/databases/$(database)/documents/rewardProfiles/$(uid)).data.claimed.hasAny([incoming().idempotencyKey]) &&
              (
                (
                  incoming().idempotencyKey == 'reward_checkin_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/rewardProfiles/$(uid)).data.checkInDate == todayUtc() &&
                  incoming().amount == [50, 80, 120, 180, 250, 350, 500][getAfter(/databases/$(database)/documents/rewardProfiles/$(uid)).data.streak - 1]
                ) ||
                (
                  incoming().idempotencyKey == 'reward_watch_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/rewardProfiles/$(uid)).data.watchSeconds >= 600 &&
                  incoming().amount == 100
                ) ||
                (
                  incoming().idempotencyKey == 'reward_gift_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/rewardProfiles/$(uid)).data.giftsSent >= 3 &&
                  incoming().amount == 150
                ) ||
                (
                  incoming().idempotencyKey == 'reward_follow_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/rewardProfiles/$(uid)).data.followsMade >= 2 &&
                  incoming().amount == 80
                ) ||
                (
                  incoming().idempotencyKey == 'reward_game_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/rewardProfiles/$(uid)).data.gamesPlayed >= 3 &&
                  incoming().amount == 100
                )
              )
            ) ||
            (
              // Host Reward claims (female hosts only): once per task per UTC
              // day, exact configured Diamond amount, progress verified, and
              // exact diamond-balance increase.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'DIAMOND' &&
              get(/databases/$(database)/documents/users/$(uid)).data.gender == 'Female' &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.diamondBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.diamondBalance &&
              getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.day == todayUtc() &&
              !get(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.claimed.hasAny([incoming().idempotencyKey]) &&
              getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.claimed.hasAny([incoming().idempotencyKey]) &&
              (
                (
                  incoming().idempotencyKey == 'host_newbie' &&
                  getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.firstLiveDone == true &&
                  getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.liveSeconds >= 60 &&
                  incoming().amount == 2000
                ) ||
                (
                  incoming().idempotencyKey == 'host_live30_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.liveSeconds >= 1800 &&
                  incoming().amount == 500
                ) ||
                (
                  incoming().idempotencyKey == 'host_live60_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.liveSeconds >= 3600 &&
                  incoming().amount == 1000
                ) ||
                (
                  incoming().idempotencyKey == 'host_gift_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.giftsReceived >= 5 &&
                  incoming().amount == 500
                ) ||
                (
                  incoming().idempotencyKey == 'host_follow_' + todayUtc() &&
                  getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.newFollowers >= 3 &&
                  incoming().amount == 300
                ) ||
                (
                  incoming().idempotencyKey == 'host_valid_' + todayUtc() &&
                  get(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.validDays >= 5 &&
                  getAfter(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.validDays ==
                    get(/databases/$(database)/documents/hostRewardProfiles/$(uid)).data.validDays - 5 &&
                  incoming().amount == 5000
                )
              )
            ) ||
            (
              // Diamonds Withdraw credit on the agent side: tied to the
              // sender's same-batch diamond debit (97% bound) and the exact
              // trading-balance increase.
              uid != request.auth.uid &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'COIN' &&
              isAgencyWallet(uid) &&
              isVerifiedUser() &&
              incoming().idempotencyKey.matches('^tx_w_c_.*$') &&
              getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance <
                get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance &&
              incoming().amount * 100 <=
                (
                  get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance -
                  getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.diamondBalance
                ) * 97 &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.tradingCoinBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.tradingCoinBalance
            ) ||
            (
              // Coin Deposit Vault return: principal + bonus (max deposit
              // 1,000,000 x 1.4 = 1,400,000), exactly the wallet increase.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'COIN' &&
              incoming().idempotencyKey.matches('^with_.*$') &&
              incoming().amount <= 1400000 &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance
            ) ||
            (
              // Coins -> Diamonds conversion credit: exact diamond increase,
              // bounded by 70% of the same-batch coin debit.
              isOwner(uid) &&
              incoming().direction == 'CREDIT' &&
              incoming().currency == 'DIAMOND' &&
              incoming().idempotencyKey.matches('^tx_conv_c_.*$') &&
              incoming().amount ==
                getAfter(/databases/$(database)/documents/wallets/$(uid)).data.diamondBalance -
                get(/databases/$(database)/documents/wallets/$(uid)).data.diamondBalance &&
              getAfter(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance <
                get(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance &&
              incoming().amount * 10 <=
                (
                  get(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance -
                  getAfter(/databases/$(database)/documents/wallets/$(uid)).data.coinBalance
                ) * 7
            )
          );
      }
    }

    // Super Agent Promotion Audit Trail (Super Agent only — separate from Admin)
    match /accountPromotions/{promotionId} {
      allow get: if isValidId(promotionId) && (isSuperAgent() || isAdmin());
      allow list: if isSuperAgent() || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(promotionId) &&
        isSuperAgent() &&
        isValidPromotion(incoming(), promotionId);
    }

    // Safety & Moderation Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && (isAdmin() || isSuperAgent() || (isSignedIn() && existing().reporterUid == request.auth.uid));
      allow list: if isAdmin() || isSuperAgent() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow delete: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidReport(incoming(), reportId) &&
        incoming().reporterUid == request.auth.uid &&
        incoming().status == 'OPEN' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(reportId) &&
        (isAdmin() || isSuperAgent()) &&
        isValidReport(incoming(), reportId) &&
        incoming().reportId == existing().reportId &&
        incoming().reporterUid == existing().reporterUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Admin action audit trail (immutable, admin-only)
    match /adminAudit/{auditId} {
      allow get: if isValidId(auditId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(auditId) &&
        incoming().keys().hasAll(['auditId', 'actorUid', 'actorUsername', 'action', 'targetId', 'detail', 'createdAt']) &&
        incoming().keys().hasOnly(['auditId', 'actorUid', 'actorUsername', 'action', 'targetId', 'detail', 'createdAt']) &&
        incoming().auditId == auditId &&
        incoming().actorUid == request.auth.uid &&
        incoming().actorUsername is string && incoming().actorUsername.size() >= 1 && incoming().actorUsername.size() <= 32 &&
        incoming().action is string && incoming().action.size() >= 1 && incoming().action.size() <= 48 &&
        incoming().targetId is string && incoming().targetId.size() <= 128 &&
        incoming().detail is string && incoming().detail.size() <= 240 &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Platform announcements (admin-published, public read)
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow delete: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(announcementId) &&
        incoming().keys().hasAll(['announcementId', 'title', 'message', 'status', 'createdByUid', 'createdByUsername', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['announcementId', 'title', 'message', 'status', 'createdByUid', 'createdByUsername', 'createdAt', 'updatedAt']) &&
        incoming().announcementId == announcementId &&
        incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 80 &&
        incoming().message is string && incoming().message.size() >= 1 && incoming().message.size() <= 300 &&
        incoming().status == 'ACTIVE' &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdByUsername is string && incoming().createdByUsername.size() >= 1 && incoming().createdByUsername.size() <= 32 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(announcementId) &&
        incoming().announcementId == existing().announcementId &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdByUsername == existing().createdByUsername &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 80 &&
        incoming().message is string && incoming().message.size() >= 1 && incoming().message.size() <= 300 &&
        incoming().status in ['ACTIVE', 'ENDED'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'status', 'updatedAt']);
    }
  }
}
